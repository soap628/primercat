# 数据库密码（自己生成一个随机字符串）
POSTGRES_PASSWORD=change_me_to_a_strong_password

# JWT 密钥（至少 32 字符的随机字符串，可用：openssl rand -hex 32）
SECRET_KEY=change_me_to_a_random_secret_key

# NCBI 要求自动化客户端提供有效联系邮箱。生产环境请务必替换。
NCBI_EMAIL=your_email@example.com
NCBI_TOOL=primercat

# 可选：Entrez API key（在 NCBI 账户中申请）。
NCBI_API_KEY=
