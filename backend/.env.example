DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biodesign
SECRET_KEY=your-secret-key-here
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=your@email.com
NCBI_TOOL=primercat
NCBI_REQUEST_INTERVAL_SECONDS=0.34
NCBI_REQUEST_INTERVAL_WITH_API_KEY_SECONDS=0.11
NCBI_CACHE_TTL_SECONDS=3600
NCBI_CACHE_MAXSIZE=256
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GRNA_OFFTARGET_BACKEND=auto
GRNA_ENABLE_NT_BLAST_FALLBACK=true
GRNA_MAX_OFFTARGET_MISMATCHES=3
GRNA_BOWTIE2_PATH=bowtie2
GRNA_BOWTIE2_MAX_ALIGNMENTS=32
GRNA_BOWTIE2_INDEX_HUMAN=
GRNA_BOWTIE2_INDEX_MOUSE=
GRNA_GENOME_FASTA_HUMAN=
GRNA_GENOME_FASTA_MOUSE=
GRNA_ANNOTATION_GTF_HUMAN=
GRNA_ANNOTATION_GTF_MOUSE=
GRNA_PROMOTER_WINDOW_BP=2000
COOKIE_SECURE=true  # Must be true in production (HTTPS). Set to false for local HTTP development.
