# NCBI（必填，否则请求会被限速）
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=your@email.com
NCBI_TOOL=primercat

# CORS：填你的前端域名（多个用逗号分隔）
BACKEND_CORS_ORIGINS=https://your-domain.com

# 生产环境关闭 DEBUG
DEBUG=false

# gRNA 脱靶（可选，留空则自动降级为 NCBI BLAST）
GRNA_OFFTARGET_BACKEND=auto
GRNA_ENABLE_NT_BLAST_FALLBACK=true

# 固定版本人类与小鼠参考基因组（容器内路径由 docker-compose 统一设置）
# 主机目录通过根目录 .env 的 PRIMERCAT_REFERENCE_ROOT 配置。
QPCR_GENOME_MAX_ALIGNMENTS_PER_PRIMER=64
QPCR_GENOME_MIN_AMPLICON_BP=50
QPCR_GENOME_MAX_AMPLICON_BP=5000
GENOME_REFERENCE_ASSEMBLY_HUMAN=GCF_000001405.40
GENOME_REFERENCE_ASSEMBLY_MOUSE=GCF_000001635.27
GRNA_BOWTIE2_INDEX_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/bowtie2/GCF_000001405.40_GRCh38.p14
GRNA_GENOME_FASTA_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.fna
GRNA_ANNOTATION_GTF_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.gtf
GRNA_ANNOTATION_DB_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/grna-annotations.sqlite3
GRNA_BOWTIE2_INDEX_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/bowtie2/GCF_000001635.27_GRCm39
GRNA_GENOME_FASTA_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/GCF_000001635.27_GRCm39_genomic.fna
GRNA_ANNOTATION_GTF_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/GCF_000001635.27_GRCm39_genomic.gtf
GRNA_ANNOTATION_DB_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/grna-annotations.sqlite3
QPCR_TRANSCRIPT_LOCUS_DB_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/qpcr-transcript-loci.sqlite3
QPCR_TRANSCRIPT_LOCUS_DB_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/qpcr-transcript-loci.sqlite3
QPCR_TRANSCRIPTOME_BOWTIE2_INDEX_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/bowtie2-transcriptome/GCF_000001405.40_GRCh38.p14_rna
QPCR_TRANSCRIPTOME_FASTA_HUMAN=/var/lib/primercat/reference/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_rna.fna
QPCR_TRANSCRIPTOME_BOWTIE2_INDEX_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/bowtie2-transcriptome/GCF_000001635.27_GRCm39_rna
QPCR_TRANSCRIPTOME_FASTA_MOUSE=/var/lib/primercat/reference/GCF_000001635.27_GRCm39/GCF_000001635.27_GRCm39_rna.fna
QPCR_TRANSCRIPTOME_MAX_ALIGNMENTS_PER_PRIMER=128
QPCR_TRANSCRIPTOME_MIN_AMPLICON_BP=50
QPCR_TRANSCRIPTOME_MAX_AMPLICON_BP=5000
QPCR_CATALOG_DB=/var/lib/primercat/reference/qpcr-catalog.sqlite3
